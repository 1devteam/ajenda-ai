# Copy to ~/.ajenda/test-emails.env and set your proof inboxes.
# Used by: bash scripts/dev/email-send-proof.sh

export AJENDA_TEST_EMAIL_PRIMARY="you@example.com"
export AJENDA_TEST_EMAIL_1="inbox-one@example.com"
export AJENDA_TEST_EMAIL_2="inbox-two@example.com"
export AJENDA_TEST_EMAIL_3="inbox-three@example.com"