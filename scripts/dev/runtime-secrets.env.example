# =============================================================================
# Ajenda local runtime secrets (master copy — lives at ~/.ajenda/runtime-secrets.env)
# =============================================================================
# 1. cp scripts/dev/runtime-secrets.env.example ~/.ajenda/runtime-secrets.env
# 2. Fill values once (or run: bash scripts/dev/sync-local-secrets.sh --bootstrap)
# 3. Push into Docker/API env: bash scripts/dev/sync-local-secrets.sh
#
# Never commit ~/.ajenda/runtime-secrets.env or deploy/compose/.env.prod
# =============================================================================

# Google OIDC (sign-in + Gmail/Calendar Credentials UI — same OAuth client)
AJENDA_OIDC_CLIENT_ID=
AJENDA_OIDC_CLIENT_SECRET=
AJENDA_SESSION_SIGNING_SECRET=

# Salesforce Connected App (Credentials UI OAuth)
AJENDA_SALESFORCE_CLIENT_ID=
AJENDA_SALESFORCE_CLIENT_SECRET=

# Fernet keys (stable across restarts — required for Credentials UI at-rest encryption)
AJENDA_WEBHOOK_SECRET_ENCRYPTION_KEY=
AJENDA_RUNTIME_SECRET_ENCRYPTION_KEY=

# Stripe test mode (optional — billing checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Resend (optional — local dev usually uses AJENDA_EMAIL_PROVIDER=noop)
AJENDA_RESEND_API_KEY=

# HubSpot CRM — platform-wide (one Ajenda-owned portal; tenants do not need their own PAK)
AJENDA_HUBSPOT_PLATFORM_MASTER_KEY_ENABLED=true
AJENDA_HUBSPOT_PLATFORM_MASTER_KEY=
AJENDA_HUBSPOT_PLATFORM_MASTER_AUTO_PROVISION=true

# LLM drafting (Phase 2 — OpenAI-compatible API)
AJENDA_LLM_API_KEY=
AJENDA_LLM_BASE_URL=https://api.openai.com/v1
AJENDA_LLM_MODEL=gpt-4o-mini

# Platform email lane (Phase 3 — JSON SMTP secret, same shape as tenant SMTP credentials)
# Example: {"host":"smtp.example.com","port":587,"user":"send@ajenda.ai","password":"secret","from":"send@ajenda.ai"}
AJENDA_EMAIL_PLATFORM_MASTER_KEY_ENABLED=false
AJENDA_EMAIL_PLATFORM_SMTP_SECRET=
AJENDA_EMAIL_PLATFORM_MASTER_AUTO_PROVISION=true