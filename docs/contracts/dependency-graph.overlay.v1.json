  "invariants": [
    {"id":"tenant-isolation","status":"known_violation","rule":"Every tenant-owned database object must be covered by the tenant DB boundary, with explicit ENABLE ROW LEVEL SECURITY, FORCE ROW LEVEL SECURITY, tenant isolation policy, and reviewed admin bypass unless explicitly classified as cross-tenant/control-plane.","sources":["backend/app/dependencies/db.py","alembic/versions/0003_row_level_security.py","tests/contract/api/test_tenant_isolation_policy.py"],"applies_to":["boundary:tenant-db"]},
    {"id":"canonical-queue-admission","status":"enforced","rule":"Mission queue eligibility must converge on the canonical runtime queue-admission authority; compatibility routes may not independently enqueue or execute.","sources":["docs/contracts/authority-ledger.v1.yaml","tests/unit/architecture/test_authority_ledger_contract.py","tests/contract/api/test_mission_queue_contract.py"]},
    {"id":"single-worker-spine","status":"enforced","rule":"Actual queued execution must converge on WorkerLoop, WorkerRuntimeService, TaskDispatcher, and registered handlers.","sources":["backend/workers/worker_loop.py","backend/workers/task_dispatcher.py"]},
    {"id":"side-effect-approval","status":"enforced","rule":"Side-effecting work requires current invocation-bound authority before queue admission; otherwise it must enter review.","sources":["backend/services/execution_coordinator.py"]},
    {"id":"retry-readmission","status":"enforced","rule":"Retries must re-enter runtime governance, side-effect approval, and policy admission before requeue.","sources":["backend/services/execution_coordinator.py"]},
    {"id":"runtime-secret-boundary","status":"enforced","rule":"Raw credential secrets must not travel in task metadata or ordinary tool inputs and must be resolved only at invocation time.","sources":["backend/services/credentials/runtime_authority.py","docs/architecture/ADR-0006-external-platform-integration-doctrine.md"]},
    {"id":"governed-egress","status":"known_violation","rule":"External provider operations must be inventoried and explicitly classified; governed runtime provider operations must traverse tool/runtime authority, credential authority, and NetworkEgressAuthority rather than opening uncontrolled provider sockets.","sources":["backend/services/tools/runtime_authority.py","backend/services/network_egress.py","docs/architecture/ADR-0006-external-platform-integration-doctrine.md"],"applies_to":["py:backend.services.network_egress","external:unresolved-egress"]},
    {"id":"connector-oauth-separation","status":"enforced_design_boundary","rule":"Connector OAuth grants service access and must remain separate from application identity/login authentication.","sources":["backend/api/routes/provider_credentials.py","backend/services/credentials/gmail_oauth_connect.py"]},
    {"id":"capability-not-authority","status":"enforced_doctrine","rule":"Capability declarations describe availability but do not themselves confer runtime execution authority.","sources":["docs/architecture/ADR-0006-external-platform-integration-doctrine.md"]},
    {"id":"authority-class-stability","status":"enforced_meta_invariant","rule":"A component may not silently expand from declarative/read-model authority into governed mutation or runtime authority without ledger/proof changes.","sources":["docs/contracts/authority-ledger.v1.yaml","tests/unit/architecture/test_authority_ledger_contract.py"]},
    {"id":"route-service-injection","status":"policy_drift","rule":"Service-layer objects should enter route handlers through sanctioned dependency providers rather than direct construction.","sources":["backend/app/dependencies/services.py"]},
    {"id":"lease-owner-integrity","status":"enforced","rule":"Lease heartbeat, completion, failure, release, recovery, and dead-letter transitions must verify and preserve the current owner; no caller may overwrite or release another owner's lease.","sources":["backend/queue/adapters/redis_owner_integrity.py","tests/integration/queue/test_redis_lease_owner_integrity_real.py"],"applies_to":["state:redis-task-lease"]},
    {"id":"durable-idempotency-ownership","status":"enforced","rule":"Idempotent side effects must establish one durable execution owner before the effect occurs and provide terminal/recovery semantics for abandoned claims; check-then-execute-then-store is insufficient. SMTP claims may recover only before the durable send fence; fenced ambiguous outcomes must fail closed rather than resend.","sources":["backend/repositories/email_send_idempotency_repository.py","backend/services/tools/email_send_idempotency.py","tests/unit/tools/test_email_send_idempotency.py"],"applies_to":["state:smtp-send-claim"]},
    {"id":"http-idempotency-ownership","status":"enforced","rule":"Keyed mutating HTTP requests must establish one durable PostgreSQL execution owner before application execution; request identity must reject changed-payload reuse, transient 429/5xx outcomes must release ownership rather than become terminal replays, completed response envelopes must be encrypted at rest, and abandoned claims must be recoverable through owner-checked leases.","sources":["backend/middleware/idempotency.py","backend/services/http_idempotency_authority.py","backend/repositories/http_idempotency_repository.py","alembic/versions/0042_add_http_idempotency_receipts.py"],"applies_to":["state:http-idempotency-key"]},
    {"id":"single-use-secret-consumption","status":"enforced","rule":"Verification, bootstrap, and refresh credentials that mint successor authority must be atomically consumed before successor authority is issued.","sources":["backend/services/tenant_onboarding_orchestrator.py","backend/services/oidc_login_service.py","backend/repositories/tenant_member_repository.py","backend/repositories/api_key_repository.py","backend/repositories/customer_auth_session_repository.py","tests/integration/auth/test_single_use_credential_transitions_real.py"],"applies_to":["state:verification-token","state:bootstrap-api-key","state:customer-refresh-token"]},
    {"id":"atomic-quota-reservation","status":"enforced","rule":"Quota-limited API-key creation must serialize per tenant, evaluate the current plan and active-key gauge under that reservation, and keep the reservation through key create/revoke transaction completion.","sources":["backend/services/quota_enforcement.py","backend/repositories/tenant_repository.py","tests/integration/auth/test_api_key_quota_capacity_real.py"],"applies_to":["state:api-key-quota-capacity"]}
  ],
