# =============================================================================
# Ajenda AI — Development Environment Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Adjust values for your local setup
#   3. NEVER commit .env to version control
# =============================================================================

# --- Database ---
# Development default — change for your local Postgres instance
AJENDA_DATABASE_URL=postgresql+psycopg://ajenda:ajenda@localhost:5432/ajenda
AJENDA_DB_POOL_SIZE=5
AJENDA_DB_MAX_OVERFLOW=10
AJENDA_DB_POOL_TIMEOUT=30
AJENDA_DB_POOL_RECYCLE=1800

# --- Application ---
AJENDA_APP_NAME=Ajenda AI
AJENDA_ENV=development
AJENDA_LOG_LEVEL=DEBUG
AJENDA_LOG_JSON=false
AJENDA_HOST=0.0.0.0
AJENDA_PORT=8000

# --- Security ---
AJENDA_REDACT_KEYS=password,secret,token,api_key,authorization,cookie,set-cookie

# --- OIDC / JWT (optional in development — leave blank to disable JWT auth) ---
AJENDA_OIDC_ISSUER=
AJENDA_OIDC_AUDIENCE=ajenda-api

# --- Google Gmail CLI OAuth (local dev / E2E — never commit real secrets) ---
# Reuse OIDC web client after adding redirect URI http://127.0.0.1:8765/oauth2/callback
# or create a Desktop OAuth client via: bash scripts/google/create_cli_oauth_client.sh
AJENDA_GOOGLE_CLI_CLIENT_ID=
AJENDA_GOOGLE_CLI_CLIENT_SECRET=
AJENDA_GOOGLE_CLI_REDIRECT_URI=http://127.0.0.1:8765/oauth2/callback
# Product Credentials UI redirect (add to Google OAuth client authorized redirect URIs)
AJENDA_GMAIL_OAUTH_REDIRECT_URI=http://localhost:5173/credentials/gmail/callback
AJENDA_E2E_GMAIL_TOKEN=

# --- LinkedIn OAuth (Credentials UI — never commit real secrets) ---
AJENDA_LINKEDIN_CLIENT_ID=
AJENDA_LINKEDIN_CLIENT_SECRET=
AJENDA_LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:5173/credentials/linkedin/callback
# Optional space-separated scopes (default: openid profile email)
# AJENDA_LINKEDIN_OAUTH_SCOPES=openid profile email

# --- Salesforce OAuth (Credentials UI — never commit real secrets) ---
AJENDA_SALESFORCE_CLIENT_ID=
AJENDA_SALESFORCE_CLIENT_SECRET=
AJENDA_SALESFORCE_LOGIN_URL=https://login.salesforce.com
AJENDA_SALESFORCE_OAUTH_REDIRECT_URI=http://localhost:5173/credentials/salesforce/callback
# Optional space-separated scopes (default: api refresh_token)
# AJENDA_SALESFORCE_OAUTH_SCOPES=api refresh_token

# --- Opt-in live plugin proof (deploy/scripts/plugin-runtime-proof.sh) ---
# AJENDA_PROOF_PLUGIN_LANE_ENABLED=1
# AJENDA_E2E_LINKEDIN_TOKEN=
# AJENDA_E2E_SALESFORCE_SECRET=
# AJENDA_E2E_SALESFORCE_TOKEN=
# AJENDA_E2E_SALESFORCE_INSTANCE_HOST=mycompany.my.salesforce.com

# --- Informed autonomy (ADR-0005) ---
# off = guardian/pending_review pilot behavior (default)
# pilot = tenant_owner may launch Tier 2-3 with recorded disclaimer acknowledgment
# enforce = Tier 3 launches require autonomy_acknowledgment
AJENDA_AUTONOMY_DISCLAIMER_MODE=off

# --- Queue ---
AJENDA_QUEUE_ADAPTER=redis
AJENDA_QUEUE_URL=redis://localhost:6379/0

# --- Rate Limiting ---
AJENDA_RATE_LIMIT_REQUESTS=1000
AJENDA_RATE_LIMIT_WINDOW_SECONDS=60

# --- Budget Policy (Bundle 5.2 observe-only scaffolding) ---
AJENDA_BUDGET_POLICY_ENABLED=false
AJENDA_BUDGET_POLICY_OBSERVE_ONLY=true
AJENDA_BUDGET_POLICY_ENFORCE=false

# --- Stripe Billing (Phase 1 — Commercial Viability) ---
# Rotate all keys via secrets manager in production. Never commit real values.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret
STRIPE_PRICE_STARTER=price_starter_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_ENTERPRISE=price_enterprise_placeholder
