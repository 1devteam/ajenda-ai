# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.python-version

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
site/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/

# Test / coverage / type-check
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytestdebug.log

# Logs / runtime files
*.log
logs/
tmp/
temp/
*.pid
*.pid.lock

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# HubSpot CLI / local tokens (global creds live in ~/.hscli/ — never commit)
.hs/
hubspot.config.yml
.hsaccount
.hubspot.pat
hubspot.pat
.hubspot-credentials
*.hubspot.token

# Google CLI OAuth (tokens live in ~/.ajenda/ — never commit)
.ajenda/
google-cli-client.json
client_secret*.json

# Env / secrets — NEVER commit real env files
.env
.env.*
!.env.example
!.env.prod.example
!.env.staging.example
.env.backup*
*.pem
*.key
*.crt
secrets/
*.secret
# Compose runtime env — templates (*.example) stay committable via rules above
deploy/compose/.env.prod
deploy/compose/.env.staging

# Database / local state
*.sqlite
*.sqlite3

# Docker / local volumes
postgres_data/
docker-data/

# Alembic / migration artifacts
alembic/versions/__pycache__/

# Node / frontend artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Project outputs / generated files
docs/snapshots/
artifacts/
reports/

# Bytecode / caches anywhere
**/__pycache__/
.venv-audit/
