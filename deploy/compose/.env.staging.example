# =============================================================================
# Ajenda AI — Staging / local paid-customer-loop environment
# =============================================================================
# Copy: cp deploy/compose/.env.staging.example deploy/compose/.env.staging
# Sync runtime env for api/worker/migrate: cp deploy/compose/.env.staging deploy/compose/.env.prod
# Use with: docker compose --env-file deploy/compose/.env.prod -f deploy/compose/docker-compose.prod.yml up -d --build
# =============================================================================

POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
AJENDA_DATABASE_URL=postgresql+psycopg://ajenda:${POSTGRES_PASSWORD}@db:5432/ajenda

AJENDA_APP_NAME=Ajenda AI Staging
AJENDA_ENV=staging
AJENDA_LOG_LEVEL=INFO
AJENDA_LOG_JSON=false
AJENDA_HOST=0.0.0.0
AJENDA_PORT=8000

AJENDA_WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET
AJENDA_RUNTIME_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET

AJENDA_OIDC_ISSUER=https://accounts.google.com
AJENDA_OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
AJENDA_OIDC_AUDIENCE=ajenda-api
# Human customer login (Google / Auth0 / generic OIDC)
AJENDA_OIDC_LOGIN_ENABLED=false
AJENDA_OIDC_PROVIDER=google
AJENDA_OIDC_CLIENT_ID=
AJENDA_OIDC_CLIENT_SECRET=
AJENDA_OIDC_ID_TOKEN_AUDIENCE=
AJENDA_OIDC_SCOPES=openid email profile
AJENDA_OIDC_REDIRECT_URI_ALLOWLIST=http://localhost:8080/auth/callback
AJENDA_SESSION_SIGNING_SECRET=CHANGE_ME_GENERATE_40_PLUS_CHAR_SECRET
AJENDA_SESSION_ACCESS_TTL_SECONDS=3600
AJENDA_SESSION_REFRESH_TTL_SECONDS=604800

AJENDA_QUEUE_ADAPTER=redis
AJENDA_QUEUE_URL=redis://redis:6379/0
AJENDA_WORKER_TENANT_MODE=multi
AJENDA_WORKER_TENANT_REFRESH_SECONDS=30
AJENDA_WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001

AJENDA_RATE_LIMIT_REQUESTS=10000
AJENDA_RATE_LIMIT_WINDOW_SECONDS=60
AJENDA_AUTHZ_POLICY_MODE=rbac
AJENDA_AUTHZ_OPA_TIMEOUT_SECONDS=2.0

# Stripe test mode — run: bash deploy/scripts/stripe-staging-bootstrap.sh
# Manual UI checkout also needs: stripe listen --forward-to localhost:8000/v1/billing/webhook/stripe
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_CHANGE_ME
STRIPE_PRICE_STARTER=price_test_starter
STRIPE_PRICE_PRO=price_test_pro

# Onboarding — noop email + exposed token for scripted staging proof without Resend
AJENDA_SIGNUP_ENABLED=true
AJENDA_EMAIL_PROVIDER=noop
AJENDA_SIGNUP_VERIFY_URL_BASE=http://localhost:8080/verify-email
AJENDA_SIGNUP_EXPOSE_VERIFICATION_TOKEN=true
AJENDA_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Relaxed signup abuse limits for local iteration (production keeps defaults: 5 IP / 3 email per hour)
AJENDA_SIGNUP_IP_LIMIT_PER_HOUR=1000
AJENDA_SIGNUP_EMAIL_LIMIT_PER_HOUR=100
AJENDA_SIGNUP_RESEND_EMAIL_LIMIT_PER_HOUR=100
AJENDA_SIGNUP_VERIFY_FAILURES_PER_HOUR=1000

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true

# Informed autonomy staging pilot (Tasks UI + ability-runtime tier-3)
AJENDA_AUTONOMY_DISCLAIMER_MODE=pilot

# HubSpot plugin egress when ingress runs via root docker-compose.yml on host :8443
AJENDA_HUBSPOT_CRM_ADAPTER_PUBLIC_HOST=hubspot-crm-ingress
AJENDA_NETWORK_EGRESS_ALLOW_PRIVATE_DESTINATIONS=true
AJENDA_NETWORK_EGRESS_TLS_VERIFY=false
AJENDA_GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/credentials/gmail/callback

# Plugin / staging proof scripts (optional — export before running deploy/scripts/staging-autonomy-plugin-proof.sh)
# AJENDA_PROOF_PLUGIN_LANE_ENABLED=1
# AJENDA_PROOF_AUTONOMY_LANE=1
# AJENDA_E2E_HUBSPOT_PAK=
# AJENDA_E2E_GMAIL_TOKEN=
# AJENDA_E2E_ADAPTER_HOST=127.0.0.1:8443