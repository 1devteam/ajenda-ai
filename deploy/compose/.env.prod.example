# =============================================================================
# Ajenda AI — Production Environment Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.prod.example .env.prod
#   2. Fill in every value marked REQUIRED
#   3. NEVER commit .env.prod to version control
#   4. Use a secrets manager (AWS Secrets Manager, Vault, K8s Secrets) in prod
# =============================================================================

# --- Database ---
# REQUIRED: Set a strong random password (min 32 chars)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_RANDOM_PASSWORD

# DATABASE_URL references POSTGRES_PASSWORD via shell variable expansion.
# Docker Compose expands ${POSTGRES_PASSWORD} at runtime. Never hardcode it.
AJENDA_DATABASE_URL=postgresql+psycopg://ajenda:${POSTGRES_PASSWORD}@db:5432/ajenda
AJENDA_DB_POOL_SIZE=20
AJENDA_DB_MAX_OVERFLOW=40
AJENDA_DB_POOL_TIMEOUT=30
AJENDA_DB_POOL_RECYCLE=1800
AJENDA_DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

# --- Vector / ephemeral data plane ---
# Colocated by default; set AJENDA_VECTOR_DATABASE_URL for dedicated Postgres.
AJENDA_VECTOR_DB_ENABLED=true
AJENDA_VECTOR_SEARCH_ENABLED=true
AJENDA_VECTOR_DB_POOL_SIZE=5
AJENDA_VECTOR_DB_MAX_OVERFLOW=10
AJENDA_EPHEMERAL_MEMORY_TTL_SECONDS=86400

# --- Application ---
AJENDA_APP_NAME=Ajenda AI
AJENDA_ENV=production
AJENDA_LOG_LEVEL=INFO
AJENDA_LOG_JSON=true
AJENDA_HOST=0.0.0.0
AJENDA_PORT=8000
AJENDA_UVICORN_WORKERS=2

# --- Security ---
# Fields to redact from all structured logs (comma-separated)
AJENDA_REDACT_KEYS=password,secret,token,api_key,authorization,cookie,set-cookie

# REQUIRED: Fernet key used to encrypt webhook signing secrets at rest.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AJENDA_WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET
# Optional previous Fernet key for key-rotation migration windows.
AJENDA_WEBHOOK_SECRET_ENCRYPTION_KEY_PREV=

# REQUIRED: Fernet key used to encrypt provider runtime credentials at rest.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AJENDA_RUNTIME_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET
# Optional previous Fernet key for provider credential key-rotation migration windows.
AJENDA_RUNTIME_SECRET_ENCRYPTION_KEY_PREV=

# --- OIDC / JWT (REQUIRED for JWT-authenticated requests) ---
# Your OIDC provider issuer URL (e.g. https://accounts.google.com or Keycloak URL)
AJENDA_OIDC_ISSUER=https://your-oidc-provider.example.com
# Your OIDC provider JWKS endpoint.
AJENDA_OIDC_JWKS_URI=https://your-oidc-provider.example.com/.well-known/jwks.json
# The audience claim your provider sets in issued JWTs
AJENDA_OIDC_AUDIENCE=ajenda-api

# --- Queue / Worker ---
AJENDA_QUEUE_ADAPTER=redis
# If Redis requires auth: redis://:PASSWORD@host:port/db
# If Redis has no auth:   redis://host:port/db
AJENDA_QUEUE_URL=redis://redis:6379/0
# Worker tenancy: single (one tenant) or multi (round-robin all active tenants).
# Use multi for self-serve SaaS so signups execute without per-tenant worker deploys.
AJENDA_WORKER_TENANT_MODE=multi
AJENDA_WORKER_TENANT_REFRESH_SECONDS=30
# Required when AJENDA_WORKER_TENANT_MODE=single. Ignored in multi mode.
AJENDA_WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Rate Limiting ---
AJENDA_RATE_LIMIT_REQUESTS=200
AJENDA_RATE_LIMIT_WINDOW_SECONDS=60

# --- Authorization policy mode ---
# Valid values: rbac, shadow_opa, enforce_opa
AJENDA_AUTHZ_POLICY_MODE=rbac
# Required only when AJENDA_AUTHZ_POLICY_MODE is shadow_opa or enforce_opa.
AJENDA_AUTHZ_OPA_URL=
AJENDA_AUTHZ_OPA_TIMEOUT_SECONDS=2.0

# --- Budget Policy (Bundle 5.2 observe-only scaffolding) ---
AJENDA_BUDGET_POLICY_ENABLED=false
AJENDA_BUDGET_POLICY_OBSERVE_ONLY=true
AJENDA_BUDGET_POLICY_ENFORCE=false

# --- Stripe billing (REQUIRED in production) ---
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_STARTER=price_CHANGE_ME_STARTER
STRIPE_PRICE_PRO=price_CHANGE_ME_PRO

# --- Self-serve onboarding email (REQUIRED in production) ---
AJENDA_SIGNUP_ENABLED=true
AJENDA_EMAIL_PROVIDER=resend
AJENDA_RESEND_API_KEY=re_CHANGE_ME
AJENDA_EMAIL_FROM=Ajenda <noreply@ajenda.example.com>
# Base URL for verification links — must match ingress host + /verify-email (see deploy/k8s/ingress.yaml)
AJENDA_SIGNUP_VERIFY_URL_BASE=https://ajenda.example.com/verify-email
AJENDA_SIGNUP_EXPOSE_VERIFICATION_TOKEN=false

# --- CORS (required in production when signup is enabled; must match customer UI origin) ---
AJENDA_CORS_ALLOWED_ORIGINS=https://ajenda.example.com

# Stripe live webhook endpoint (register in Stripe Dashboard):
# https://ajenda.example.com/v1/billing/webhook/stripe

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true
AJENDA_ASSURANCE_INTERVAL_SECONDS=300
